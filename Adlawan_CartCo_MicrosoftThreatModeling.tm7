nowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>2c8396fc-2d0d-465b-b210-2d42caf19139</b:FlowGuid><b:Id>42</b:Id><b:InteractionKey>5e9f67dc-ae06-4a78-85ec-57dc04f2878c:2c8396fc-2d0d-465b-b210-2d42caf19139:cb2ae09a-fa30-4872-bf97-6894e63c14ca</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:59:26.6064083+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Admin Order Management may be able to impersonate the context of Process Payment in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authorization: Enforce least privilege and verify service identities so one component cannot impersonate another component.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Refund request</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5e9f67dc-ae06-4a78-85ec-57dc04f2878c</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>cb2ae09a-fa30-4872-bf97-6894e63c14ca</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7e4304a69-66d6-45a8-8e81-4c914f626a6970ba1f00-eb38-403c-abb1-db3dfaa87f8ecb2ae09a-fa30-4872-bf97-6894e63c14ca</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>70ba1f00-eb38-403c-abb1-db3dfaa87f8e</b:FlowGuid><b:Id>43</b:Id><b:InteractionKey>e4304a69-66d6-45a8-8e81-4c914f626a69:70ba1f00-eb38-403c-abb1-db3dfaa87f8e:cb2ae09a-fa30-4872-bf97-6894e63c14ca</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:27:01.6423017+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store Orders DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Orders DB may be spoofed by an attacker and this may lead to incorrect data delivered to Admin Order Management. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication: Use strong authentication and verify the identity of users, processes, and external services before allowing access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Read/write orders</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e4304a69-66d6-45a8-8e81-4c914f626a69</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>cb2ae09a-fa30-4872-bf97-6894e63c14ca</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23e4304a69-66d6-45a8-8e81-4c914f626a6970ba1f00-eb38-403c-abb1-db3dfaa87f8ecb2ae09a-fa30-4872-bf97-6894e63c14ca</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>70ba1f00-eb38-403c-abb1-db3dfaa87f8e</b:FlowGuid><b:Id>44</b:Id><b:InteractionKey>e4304a69-66d6-45a8-8e81-4c914f626a69:70ba1f00-eb38-403c-abb1-db3dfaa87f8e:cb2ae09a-fa30-4872-bf97-6894e63c14ca</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:03:25.8715449+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of Orders DB can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Cryptography: Encrypt sensitive data in transit using secure TLS connections and restrict access to sensitive information.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Read/write orders</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e4304a69-66d6-45a8-8e81-4c914f626a69</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>cb2ae09a-fa30-4872-bf97-6894e63c14ca</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1cb2ae09a-fa30-4872-bf97-6894e63c14ca648547a2-ab0c-48e6-a70a-20bf9205cd7de4304a69-66d6-45a8-8e81-4c914f626a69</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>648547a2-ab0c-48e6-a70a-20bf9205cd7d</b:FlowGuid><b:Id>45</b:Id><b:InteractionKey>cb2ae09a-fa30-4872-bf97-6894e63c14ca:648547a2-ab0c-48e6-a70a-20bf9205cd7d:e4304a69-66d6-45a8-8e81-4c914f626a69</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:27:04.6439077+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store Orders DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Orders DB may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of Orders DB. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication: Use strong authentication and verify the identity of users, processes, and external services before allowing access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Read/write orders</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cb2ae09a-fa30-4872-bf97-6894e63c14ca</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e4304a69-66d6-45a8-8e81-4c914f626a69</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7cb2ae09a-fa30-4872-bf97-6894e63c14ca648547a2-ab0c-48e6-a70a-20bf9205cd7de4304a69-66d6-45a8-8e81-4c914f626a69</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>648547a2-ab0c-48e6-a70a-20bf9205cd7d</b:FlowGuid><b:Id>46</b:Id><b:InteractionKey>cb2ae09a-fa30-4872-bf97-6894e63c14ca:648547a2-ab0c-48e6-a70a-20bf9205cd7d:e4304a69-66d6-45a8-8e81-4c914f626a69</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:27:43.7164443+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for Orders DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Input Validation: Validate and sanitize all inputs on the server side and use parameterized queries to prevent malicious data from being processed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Read/write orders</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cb2ae09a-fa30-4872-bf97-6894e63c14ca</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e4304a69-66d6-45a8-8e81-4c914f626a69</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2cb2ae09a-fa30-4872-bf97-6894e63c14ca648547a2-ab0c-48e6-a70a-20bf9205cd7de4304a69-66d6-45a8-8e81-4c914f626a69</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>648547a2-ab0c-48e6-a70a-20bf9205cd7d</b:FlowGuid><b:Id>47</b:Id><b:InteractionKey>cb2ae09a-fa30-4872-bf97-6894e63c14ca:648547a2-ab0c-48e6-a70a-20bf9205cd7d:e4304a69-66d6-45a8-8e81-4c914f626a69</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:54:25.4815137+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for Admin Order Management or Orders DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Admin Order Management or Orders DB take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Exception Management: Apply rate limits, timeouts, resource limits, monitoring, and graceful error handling to maintain availability.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Read/write orders</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cb2ae09a-fa30-4872-bf97-6894e63c14ca</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e4304a69-66d6-45a8-8e81-4c914f626a69</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7e4304a69-66d6-45a8-8e81-4c914f626a69132e6ae1-df1b-43ea-88eb-e639d23e045383bae77d-67e3-40ff-9015-db35e2723b5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>132e6ae1-df1b-43ea-88eb-e639d23e0453</b:FlowGuid><b:Id>48</b:Id><b:InteractionKey>e4304a69-66d6-45a8-8e81-4c914f626a69:132e6ae1-df1b-43ea-88eb-e639d23e0453:83bae77d-67e3-40ff-9015-db35e2723b5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:27:06.9755193+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store Orders DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Orders DB may be spoofed by an attacker and this may lead to incorrect data delivered to Payment Gateway. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication: Use strong authentication and verify the identity of users, processes, and external services before allowing access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Payment status/ Refund status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e4304a69-66d6-45a8-8e81-4c914f626a69</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>83bae77d-67e3-40ff-9015-db35e2723b5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23e4304a69-66d6-45a8-8e81-4c914f626a69132e6ae1-df1b-43ea-88eb-e639d23e045383bae77d-67e3-40ff-9015-db35e2723b5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>132e6ae1-df1b-43ea-88eb-e639d23e0453</b:FlowGuid><b:Id>49</b:Id><b:InteractionKey>e4304a69-66d6-45a8-8e81-4c914f626a69:132e6ae1-df1b-43ea-88eb-e639d23e0453:83bae77d-67e3-40ff-9015-db35e2723b5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:03:30.2857825+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of Orders DB can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Cryptography: Encrypt sensitive data in transit using secure TLS connections and restrict access to sensitive information.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Payment status/ Refund status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e4304a69-66d6-45a8-8e81-4c914f626a69</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>83bae77d-67e3-40ff-9015-db35e2723b5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1cb2ae09a-fa30-4872-bf97-6894e63c14ca9501173e-8bf0-4878-9fe2-4823a4870710226cea45-ce22-49e0-8f1f-7a928370d753</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>9501173e-8bf0-4878-9fe2-4823a4870710</b:FlowGuid><b:Id>50</b:Id><b:InteractionKey>cb2ae09a-fa30-4872-bf97-6894e63c14ca:9501173e-8bf0-4878-9fe2-4823a4870710:226cea45-ce22-49e0-8f1f-7a928370d753</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:27:08.8189094+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store Orders DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Orders DB may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of Orders DB. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication: Use strong authentication and verify the identity of users, processes, and external services before allowing access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Orders DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cb2ae09a-fa30-4872-bf97-6894e63c14ca</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>226cea45-ce22-49e0-8f1f-7a928370d753</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T7cb2ae09a-fa30-4872-bf97-6894e63c14ca9501173e-8bf0-4878-9fe2-4823a4870710226cea45-ce22-49e0-8f1f-7a928370d753</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>9501173e-8bf0-4878-9fe2-4823a4870710</b:FlowGuid><b:Id>51</b:Id><b:InteractionKey>cb2ae09a-fa30-4872-bf97-6894e63c14ca:9501173e-8bf0-4878-9fe2-4823a4870710:226cea45-ce22-49e0-8f1f-7a928370d753</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:27:45.4586514+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for Orders DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Input Validation: Validate and sanitize all inputs on the server side and use parameterized queries to prevent malicious data from being processed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Orders DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cb2ae09a-fa30-4872-bf97-6894e63c14ca</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>226cea45-ce22-49e0-8f1f-7a928370d753</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2cb2ae09a-fa30-4872-bf97-6894e63c14ca9501173e-8bf0-4878-9fe2-4823a4870710226cea45-ce22-49e0-8f1f-7a928370d753</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>9501173e-8bf0-4878-9fe2-4823a4870710</b:FlowGuid><b:Id>52</b:Id><b:InteractionKey>cb2ae09a-fa30-4872-bf97-6894e63c14ca:9501173e-8bf0-4878-9fe2-4823a4870710:226cea45-ce22-49e0-8f1f-7a928370d753</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:54:30.5290164+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for Admin Order Management or Orders DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Admin Order Management or Orders DB take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Exception Management: Apply rate limits, timeouts, resource limits, monitoring, and graceful error handling to maintain availability.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Orders DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cb2ae09a-fa30-4872-bf97-6894e63c14ca</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>226cea45-ce22-49e0-8f1f-7a928370d753</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D364c517b6-37e0-4afd-9616-acc6c156c0a8a500dfed-024f-48bb-9b84-64bb6e571101c6ab27a4-2eff-4da3-9b72-5e66d69acd34</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>a500dfed-024f-48bb-9b84-64bb6e571101</b:FlowGuid><b:Id>131</b:Id><b:InteractionKey>64c517b6-37e0-4afd-9616-acc6c156c0a8:a500dfed-024f-48bb-9b84-64bb6e571101:c6ab27a4-2eff-4da3-9b72-5e66d69acd34</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:57:10.2881268+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Send Order Confirmation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Send Order Confirmation crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Exception Management: Apply rate limits, timeouts, resource limits, monitoring, and graceful error handling to maintain availability.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Order confirmation data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>64c517b6-37e0-4afd-9616-acc6c156c0a8</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6ab27a4-2eff-4da3-9b72-5e66d69acd34</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I664c517b6-37e0-4afd-9616-acc6c156c0a8a500dfed-024f-48bb-9b84-64bb6e571101c6ab27a4-2eff-4da3-9b72-5e66d69acd34</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>a500dfed-024f-48bb-9b84-64bb6e571101</b:FlowGuid><b:Id>130</b:Id><b:InteractionKey>64c517b6-37e0-4afd-9616-acc6c156c0a8:a500dfed-024f-48bb-9b84-64bb6e571101:c6ab27a4-2eff-4da3-9b72-5e66d69acd34</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:06:12.9974004+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Order confirmation data may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Cryptography: Encrypt sensitive data in transit using secure TLS connections and restrict access to sensitive information.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Order confirmation data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>64c517b6-37e0-4afd-9616-acc6c156c0a8</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6ab27a4-2eff-4da3-9b72-5e66d69acd34</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R664c517b6-37e0-4afd-9616-acc6c156c0a8a500dfed-024f-48bb-9b84-64bb6e571101c6ab27a4-2eff-4da3-9b72-5e66d69acd34</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>a500dfed-024f-48bb-9b84-64bb6e571101</b:FlowGuid><b:Id>129</b:Id><b:InteractionKey>64c517b6-37e0-4afd-9616-acc6c156c0a8:a500dfed-024f-48bb-9b84-64bb6e571101:c6ab27a4-2eff-4da3-9b72-5e66d69acd34</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:12:56.9041735+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Send Order Confirmation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Send Order Confirmation claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Auditing: Maintain logs containing the actor, timestamp, operation, source, and result to provide accountability and traceability.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Order confirmation data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>64c517b6-37e0-4afd-9616-acc6c156c0a8</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6ab27a4-2eff-4da3-9b72-5e66d69acd34</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T164c517b6-37e0-4afd-9616-acc6c156c0a8a500dfed-024f-48bb-9b84-64bb6e571101c6ab27a4-2eff-4da3-9b72-5e66d69acd34</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>a500dfed-024f-48bb-9b84-64bb6e571101</b:FlowGuid><b:Id>128</b:Id><b:InteractionKey>64c517b6-37e0-4afd-9616-acc6c156c0a8:a500dfed-024f-48bb-9b84-64bb6e571101:c6ab27a4-2eff-4da3-9b72-5e66d69acd34</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:28:30.8793228+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for Send Order Confirmation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Order confirmation data may be tampered with by an attacker. This may lead to a denial of service attack against Send Order Confirmation or an elevation of privilege attack against Send Order Confirmation or an information disclosure by Send Order Confirmation. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Input Validation: Validate and sanitize all inputs on the server side and use parameterized queries to prevent malicious data from being processed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Order confirmation data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>64c517b6-37e0-4afd-9616-acc6c156c0a8</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6ab27a4-2eff-4da3-9b72-5e66d69acd34</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S264c517b6-37e0-4afd-9616-acc6c156c0a8a500dfed-024f-48bb-9b84-64bb6e571101c6ab27a4-2eff-4da3-9b72-5e66d69acd34</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>a500dfed-024f-48bb-9b84-64bb6e571101</b:FlowGuid><b:Id>127</b:Id><b:InteractionKey>64c517b6-37e0-4afd-9616-acc6c156c0a8:a500dfed-024f-48bb-9b84-64bb6e571101:c6ab27a4-2eff-4da3-9b72-5e66d69acd34</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:27:32.9796056+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Send Order Confirmation Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Send Order Confirmation may be spoofed by an attacker and this may lead to information disclosure by Checkout Service. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication: Use strong authentication and verify the identity of users, processes, and external services before allowing access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Order confirmation data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>64c517b6-37e0-4afd-9616-acc6c156c0a8</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6ab27a4-2eff-4da3-9b72-5e66d69acd34</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S164c517b6-37e0-4afd-9616-acc6c156c0a8a500dfed-024f-48bb-9b84-64bb6e571101c6ab27a4-2eff-4da3-9b72-5e66d69acd34</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>a500dfed-024f-48bb-9b84-64bb6e571101</b:FlowGuid><b:Id>126</b:Id><b:InteractionKey>64c517b6-37e0-4afd-9616-acc6c156c0a8:a500dfed-024f-48bb-9b84-64bb6e571101:c6ab27a4-2eff-4da3-9b72-5e66d69acd34</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:27:30.5762037+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Checkout Service Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Checkout Service may be spoofed by an attacker and this may lead to unauthorized access to Send Order Confirmation. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication: Use strong authentication and verify the identity of users, processes, and external services before allowing access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Order confirmation data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>64c517b6-37e0-4afd-9616-acc6c156c0a8</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c6ab27a4-2eff-4da3-9b72-5e66d69acd34</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S250cd5546-6c33-4ed7-9148-5cef398345c20de5dc00-9d7e-4ffd-b4a5-a8c5c74ff68740caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687</b:FlowGuid><b:Id>59</b:Id><b:InteractionKey>50cd5546-6c33-4ed7-9148-5cef398345c2:0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:27:10.890297+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Authenticate User Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Authenticate User may be spoofed by an attacker and this may lead to information disclosure by Customer. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication: Use strong authentication and verify the identity of users, processes, and external services before allowing access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>50cd5546-6c33-4ed7-9148-5cef398345c2</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T150cd5546-6c33-4ed7-9148-5cef398345c20de5dc00-9d7e-4ffd-b4a5-a8c5c74ff68740caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687</b:FlowGuid><b:Id>60</b:Id><b:InteractionKey>50cd5546-6c33-4ed7-9148-5cef398345c2:0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:27:48.5113847+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for Authenticate User</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Credentials may be tampered with by an attacker. This may lead to a denial of service attack against Authenticate User or an elevation of privilege attack against Authenticate User or an information disclosure by Authenticate User. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Input Validation: Validate and sanitize all inputs on the server side and use parameterized queries to prevent malicious data from being processed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>50cd5546-6c33-4ed7-9148-5cef398345c2</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R650cd5546-6c33-4ed7-9148-5cef398345c20de5dc00-9d7e-4ffd-b4a5-a8c5c74ff68740caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687</b:FlowGuid><b:Id>61</b:Id><b:InteractionKey>50cd5546-6c33-4ed7-9148-5cef398345c2:0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:08:00.0127263+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Authenticate User</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Authenticate User claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Auditing: Maintain logs containing the actor, timestamp, operation, source, and result to provide accountability and traceability.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>50cd5546-6c33-4ed7-9148-5cef398345c2</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I650cd5546-6c33-4ed7-9148-5cef398345c20de5dc00-9d7e-4ffd-b4a5-a8c5c74ff68740caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687</b:FlowGuid><b:Id>62</b:Id><b:InteractionKey>50cd5546-6c33-4ed7-9148-5cef398345c2:0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:03:34.0994712+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across Credentials may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Cryptography: Encrypt sensitive data in transit using secure TLS connections and restrict access to sensitive information.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>50cd5546-6c33-4ed7-9148-5cef398345c2</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D350cd5546-6c33-4ed7-9148-5cef398345c20de5dc00-9d7e-4ffd-b4a5-a8c5c74ff68740caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687</b:FlowGuid><b:Id>63</b:Id><b:InteractionKey>50cd5546-6c33-4ed7-9148-5cef398345c2:0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:54:46.234126+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Authenticate User</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Authenticate User crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Exception Management: Apply rate limits, timeouts, resource limits, monitoring, and graceful error handling to maintain availability.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>50cd5546-6c33-4ed7-9148-5cef398345c2</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D450cd5546-6c33-4ed7-9148-5cef398345c20de5dc00-9d7e-4ffd-b4a5-a8c5c74ff68740caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687</b:FlowGuid><b:Id>64</b:Id><b:InteractionKey>50cd5546-6c33-4ed7-9148-5cef398345c2:0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:54:49.8544517+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Credentials Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Exception Management: Apply rate limits, timeouts, resource limits, monitoring, and graceful error handling to maintain availability.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>50cd5546-6c33-4ed7-9148-5cef398345c2</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E650cd5546-6c33-4ed7-9148-5cef398345c20de5dc00-9d7e-4ffd-b4a5-a8c5c74ff68740caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687</b:FlowGuid><b:Id>65</b:Id><b:InteractionKey>50cd5546-6c33-4ed7-9148-5cef398345c2:0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:59:31.1297793+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Authenticate User May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Customer may be able to remotely execute code for Authenticate User.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authorization: Enforce least privilege and verify service identities so one component cannot impersonate another component.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>50cd5546-6c33-4ed7-9148-5cef398345c2</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E750cd5546-6c33-4ed7-9148-5cef398345c20de5dc00-9d7e-4ffd-b4a5-a8c5c74ff68740caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687</b:FlowGuid><b:Id>66</b:Id><b:InteractionKey>50cd5546-6c33-4ed7-9148-5cef398345c2:0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:59:35.6884207+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Authenticate User</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Authenticate User in order to change the flow of program execution within Authenticate User to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authorization: Enforce least privilege and verify service identities so one component cannot impersonate another component.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>50cd5546-6c33-4ed7-9148-5cef398345c2</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b026150cd5546-6c33-4ed7-9148-5cef398345c20de5dc00-9d7e-4ffd-b4a5-a8c5c74ff68740caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687</b:FlowGuid><b:Id>67</b:Id><b:InteractionKey>50cd5546-6c33-4ed7-9148-5cef398345c2:0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:59:52.6921995+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting. The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authorization: Enforce least privilege and verify service identities so one component cannot impersonate another component.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>50cd5546-6c33-4ed7-9148-5cef398345c2</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R8fdd5e515-eeec-4c14-8219-e8b027c38b338fd80df9-0037-4b3f-9bd5-b6fb40b0152d3130f9d0-6ce4-420e-8193-f63143dc318e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>8fd80df9-0037-4b3f-9bd5-b6fb40b0152d</b:FlowGuid><b:Id>68</b:Id><b:InteractionKey>fdd5e515-eeec-4c14-8219-e8b027c38b33:8fd80df9-0037-4b3f-9bd5-b6fb40b0152d:3130f9d0-6ce4-420e-8193-f63143dc318e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:10:08.2750712+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Denies User Accounts DB Potentially Writing Data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>User Accounts DB claims that it did not write data received from an entity on the other side of the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Auditing: Maintain logs containing the actor, timestamp, operation, source, and result to provide accountability and traceability.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>From User Accounts DB to User Accounts DB via unnamed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fdd5e515-eeec-4c14-8219-e8b027c38b33</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3130f9d0-6ce4-420e-8193-f63143dc318e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R8</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4fdd5e515-eeec-4c14-8219-e8b027c38b338fd80df9-0037-4b3f-9bd5-b6fb40b0152d3130f9d0-6ce4-420e-8193-f63143dc318e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>8fd80df9-0037-4b3f-9bd5-b6fb40b0152d</b:FlowGuid><b:Id>69</b:Id><b:InteractionKey>fdd5e515-eeec-4c14-8219-e8b027c38b33:8fd80df9-0037-4b3f-9bd5-b6fb40b0152d:3130f9d0-6ce4-420e-8193-f63143dc318e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:54:53.4868515+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow  Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatSh