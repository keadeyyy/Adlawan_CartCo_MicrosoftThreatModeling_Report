bstracts">East</PortSource><PortTarget xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">East</PortTarget><SourceGuid xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">cb2ae09a-fa30-4872-bf97-6894e63c14ca</SourceGuid><SourceX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">1487</SourceX><SourceY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">295</SourceY><TargetGuid xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">226cea45-ce22-49e0-8f1f-7a928370d753</TargetGuid><TargetX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">1655</TargetX><TargetY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">760</TargetY></a:Value></a:KeyValueOfguidanyType></Lines><Zoom>0.5</Zoom></DrawingSurfaceModel></DrawingSurfaceList><MetaInformation><Assumptions/><Contributors/><ExternalDependencies/><HighLevelSystemDescription/><Owner/><Reviewer/><ThreatModelName/></MetaInformation><Notes/><ThreatInstances xmlns:a="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S350cd5546-6c33-4ed7-9148-5cef398345c20de5dc00-9d7e-4ffd-b4a5-a8c5c74ff68740caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687</b:FlowGuid><b:Id>154</b:Id><b:InteractionKey>50cd5546-6c33-4ed7-9148-5cef398345c2:0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:15:17.4836452+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Customer External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Customer may be spoofed by an attacker and this may lead to unauthorized access to Authenticate User. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication: Use strong authentication and verify the identity of users, processes, and external services before allowing access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>50cd5546-6c33-4ed7-9148-5cef398345c2</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E550cd5546-6c33-4ed7-9148-5cef398345c20de5dc00-9d7e-4ffd-b4a5-a8c5c74ff68740caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687</b:FlowGuid><b:Id>1</b:Id><b:InteractionKey>50cd5546-6c33-4ed7-9148-5cef398345c2:0de5dc00-9d7e-4ffd-b4a5-a8c5c74ff687:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:47:28.3376455+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Authenticate User may be able to impersonate the context of Customer in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authorization: Enforce least privilege and verify service identities so one component cannot impersonate another component.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>50cd5546-6c33-4ed7-9148-5cef398345c2</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.140caa359-8109-450e-aef8-606d1b91ce7e6a7097b1-ea4f-4908-b35f-14d3de3f9157fdd5e515-eeec-4c14-8219-e8b027c38b33</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>6a7097b1-ea4f-4908-b35f-14d3de3f9157</b:FlowGuid><b:Id>2</b:Id><b:InteractionKey>40caa359-8109-450e-aef8-606d1b91ce7e:6a7097b1-ea4f-4908-b35f-14d3de3f9157:fdd5e515-eeec-4c14-8219-e8b027c38b33</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:47:32.8669194+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store User Accounts DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>User Accounts DB may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of User Accounts DB. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication: Use strong authentication and verify the identity of users, processes, and external services before allowing access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lookup</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fdd5e515-eeec-4c14-8219-e8b027c38b33</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T740caa359-8109-450e-aef8-606d1b91ce7e6a7097b1-ea4f-4908-b35f-14d3de3f9157fdd5e515-eeec-4c14-8219-e8b027c38b33</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>6a7097b1-ea4f-4908-b35f-14d3de3f9157</b:FlowGuid><b:Id>3</b:Id><b:InteractionKey>40caa359-8109-450e-aef8-606d1b91ce7e:6a7097b1-ea4f-4908-b35f-14d3de3f9157:fdd5e515-eeec-4c14-8219-e8b027c38b33</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:26:12.9889179+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for User Accounts DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Input Validation: Validate and sanitize all inputs on the server side and use parameterized queries to prevent malicious data from being processed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lookup</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fdd5e515-eeec-4c14-8219-e8b027c38b33</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D240caa359-8109-450e-aef8-606d1b91ce7e6a7097b1-ea4f-4908-b35f-14d3de3f9157fdd5e515-eeec-4c14-8219-e8b027c38b33</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>6a7097b1-ea4f-4908-b35f-14d3de3f9157</b:FlowGuid><b:Id>4</b:Id><b:InteractionKey>40caa359-8109-450e-aef8-606d1b91ce7e:6a7097b1-ea4f-4908-b35f-14d3de3f9157:fdd5e515-eeec-4c14-8219-e8b027c38b33</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:50:19.3723059+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for Authenticate User or User Accounts DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Authenticate User or User Accounts DB take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Exception Management: Apply rate limits, timeouts, resource limits, monitoring, and graceful error handling to maintain availability.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account Lookup</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fdd5e515-eeec-4c14-8219-e8b027c38b33</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7fdd5e515-eeec-4c14-8219-e8b027c38b33a9fa8b16-649b-4694-b3dc-d7f157f0003640caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>a9fa8b16-649b-4694-b3dc-d7f157f00036</b:FlowGuid><b:Id>5</b:Id><b:InteractionKey>fdd5e515-eeec-4c14-8219-e8b027c38b33:a9fa8b16-649b-4694-b3dc-d7f157f00036:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:50:37.2856969+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store User Accounts DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>User Accounts DB may be spoofed by an attacker and this may lead to incorrect data delivered to Authenticate User. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication: Use strong authentication and verify the identity of users, processes, and external services before allowing access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account/role information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fdd5e515-eeec-4c14-8219-e8b027c38b33</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23fdd5e515-eeec-4c14-8219-e8b027c38b33a9fa8b16-649b-4694-b3dc-d7f157f0003640caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>a9fa8b16-649b-4694-b3dc-d7f157f00036</b:FlowGuid><b:Id>6</b:Id><b:InteractionKey>fdd5e515-eeec-4c14-8219-e8b027c38b33:a9fa8b16-649b-4694-b3dc-d7f157f00036:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:02:12.8458349+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of User Accounts DB can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Cryptography: Encrypt sensitive data in transit using secure TLS connections and restrict access to sensitive information.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account/role information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>fdd5e515-eeec-4c14-8219-e8b027c38b33</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.140caa359-8109-450e-aef8-606d1b91ce7eebe0c0de-a562-422d-81ff-e8eb7f69f727fdd5e515-eeec-4c14-8219-e8b027c38b33</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>ebe0c0de-a562-422d-81ff-e8eb7f69f727</b:FlowGuid><b:Id>7</b:Id><b:InteractionKey>40caa359-8109-450e-aef8-606d1b91ce7e:ebe0c0de-a562-422d-81ff-e8eb7f69f727:fdd5e515-eeec-4c14-8219-e8b027c38b33</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:53:24.3021225+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store User Accounts DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>User Accounts DB may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of User Accounts DB. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication: Use strong authentication and verify the identity of users, processes, and external services before allowing access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account/role information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fdd5e515-eeec-4c14-8219-e8b027c38b33</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T740caa359-8109-450e-aef8-606d1b91ce7eebe0c0de-a562-422d-81ff-e8eb7f69f727fdd5e515-eeec-4c14-8219-e8b027c38b33</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>ebe0c0de-a562-422d-81ff-e8eb7f69f727</b:FlowGuid><b:Id>8</b:Id><b:InteractionKey>40caa359-8109-450e-aef8-606d1b91ce7e:ebe0c0de-a562-422d-81ff-e8eb7f69f727:fdd5e515-eeec-4c14-8219-e8b027c38b33</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:53:37.3267708+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential SQL Injection Vulnerability for User Accounts DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SQL injection is an attack in which malicious code is inserted into strings that are later passed to an instance of SQL Server for parsing and execution. Any procedure that constructs SQL statements should be reviewed for injection vulnerabilities because SQL Server will execute all syntactically valid queries that it receives. Even parameterized data can be manipulated by a skilled and determined attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Input Validation: Validate and sanitize all inputs on the server side and use parameterized queries to prevent malicious data from being processed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account/role information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fdd5e515-eeec-4c14-8219-e8b027c38b33</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D240caa359-8109-450e-aef8-606d1b91ce7eebe0c0de-a562-422d-81ff-e8eb7f69f727fdd5e515-eeec-4c14-8219-e8b027c38b33</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>ebe0c0de-a562-422d-81ff-e8eb7f69f727</b:FlowGuid><b:Id>9</b:Id><b:InteractionKey>40caa359-8109-450e-aef8-606d1b91ce7e:ebe0c0de-a562-422d-81ff-e8eb7f69f727:fdd5e515-eeec-4c14-8219-e8b027c38b33</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:54:03.1069728+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for Authenticate User or User Accounts DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Authenticate User or User Accounts DB take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Exception Management: Apply rate limits, timeouts, resource limits, monitoring, and graceful error handling to maintain availability.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Account/role information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fdd5e515-eeec-4c14-8219-e8b027c38b33</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.140caa359-8109-450e-aef8-606d1b91ce7e4374b532-6894-4986-8efc-a1428b7ec12032db5aed-57d1-4666-b687-b3116b4a084f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>4374b532-6894-4986-8efc-a1428b7ec120</b:FlowGuid><b:Id>10</b:Id><b:InteractionKey>40caa359-8109-450e-aef8-606d1b91ce7e:4374b532-6894-4986-8efc-a1428b7ec120:32db5aed-57d1-4666-b687-b3116b4a084f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:18:05.0564973+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store Session Store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session Store may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of Session Store. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication: Use strong authentication and verify the identity of users, processes, and external services before allowing access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Session validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>32db5aed-57d1-4666-b687-b3116b4a084f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D240caa359-8109-450e-aef8-606d1b91ce7e4374b532-6894-4986-8efc-a1428b7ec12032db5aed-57d1-4666-b687-b3116b4a084f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>4374b532-6894-4986-8efc-a1428b7ec120</b:FlowGuid><b:Id>11</b:Id><b:InteractionKey>40caa359-8109-450e-aef8-606d1b91ce7e:4374b532-6894-4986-8efc-a1428b7ec120:32db5aed-57d1-4666-b687-b3116b4a084f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-12T23:54:07.4712705+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for Authenticate User or Session Store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Authenticate User or Session Store take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Exception Management: Apply rate limits, timeouts, resource limits, monitoring, and graceful error handling to maintain availability.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Session validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>32db5aed-57d1-4666-b687-b3116b4a084f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S732db5aed-57d1-4666-b687-b3116b4a084fd86e11f2-a50e-4d93-bd2a-f5b71d683b6e40caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>d86e11f2-a50e-4d93-bd2a-f5b71d683b6e</b:FlowGuid><b:Id>12</b:Id><b:InteractionKey>32db5aed-57d1-4666-b687-b3116b4a084f:d86e11f2-a50e-4d93-bd2a-f5b71d683b6e:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:18:11.1558307+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store Session Store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session Store may be spoofed by an attacker and this may lead to incorrect data delivered to Authenticate User. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Authentication: Use strong authentication and verify the identity of users, processes, and external services before allowing access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Session validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>32db5aed-57d1-4666-b687-b3116b4a084f</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I2332db5aed-57d1-4666-b687-b3116b4a084fd86e11f2-a50e-4d93-bd2a-f5b71d683b6e40caa359-8109-450e-aef8-606d1b91ce7e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>d86e11f2-a50e-4d93-bd2a-f5b71d683b6e</b:FlowGuid><b:Id>13</b:Id><b:InteractionKey>32db5aed-57d1-4666-b687-b3116b4a084f:d86e11f2-a50e-4d93-bd2a-f5b71d683b6e:40caa359-8109-450e-aef8-606d1b91ce7e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:03:19.3002397+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of Session Store can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Cryptography: Encrypt sensitive data in transit using secure TLS connections and restrict access to sensitive information.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Session validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>32db5aed-57d1-4666-b687-b3116b4a084f</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>40caa359-8109-450e-aef8-606d1b91ce7e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7fdd5e515-eeec-4c14-8219-e8b027c38b338fd80df9-0037-4b3f-9bd5-b6fb40b0152d3130f9d0-6ce4-420e-8193-f63143dc318e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-7E5D9MU\james</b:ChangedBy><b:DrawingSurfaceGuid>1d9910bf-f28c-4c80-bd03-1e793bc90394</b:DrawingSurfaceGuid><b:FlowGuid>8fd80df9-0037-4b3f-9bd5-b6fb40b0152d</b:FlowGuid><b:Id>14</b:Id><b:InteractionKey>fdd5e515-eeec-4c14-8219-e8b027c38b33:8fd80df9-0037-4b3f-9bd5-b6fb40b0152d:3130f9d0-6ce4-420e-8193-f63143dc318e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-09-13T00:18:23.9400786+08:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store User Accounts DB</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identi